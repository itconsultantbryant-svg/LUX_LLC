# Demo environment — HealthWallet Liberia (LUX HealthTrust)
#
# A clearly labelled, synthetic-only deployment. It must keep sandbox adapters:
# the API refuses `PAYMENT_ADAPTER=live` without partner credentials, and demo
# data is seeded with `--synthetic` only.
#
# This file is a REFERENCE. Never commit real secrets. Copy the values you need
# into your secret manager / hosting provider environment UI.
#
# Backend: Neon Function. Frontend: Vercel. Database: Neon Postgres.

# --- Backend (Neon Function) ---
APP_ENV=demo
PORT=4000
HOST=0.0.0.0
# Neon injects DATABASE_URL for the function; set it explicitly for CLI use.
# Use the pooled connection for traffic and the unpooled one for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@BRANCH-pooler.REGION.aws.neon.tech/healthwallet_demo?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@BRANCH.REGION.aws.neon.tech/healthwallet_demo?sslmode=require
# The Vercel origin(s) that may call the API. Comma-separated.
CORS_ORIGIN=https://REPLACE_DEMO_WEB_ORIGIN

AI_ADAPTER=sandbox
PAYMENT_ADAPTER=sandbox
MESSAGING_ADAPTER=sandbox
PHONE_VERIFICATION_PROVIDER=sandbox
STORAGE_ADAPTER=s3
STORAGE_LOCAL_ROOT=/tmp/healthwallet-sandbox
DEFAULT_CURRENCY=LRD
LOG_LEVEL=info

# Server-only shared secret between Vercel Edge Middleware and the Neon
# Function. >= 32 random characters. Identical on both sides.
ORIGIN_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS

# Signs short-lived, actor-bound document download links. 64 hex characters.
SECURITY_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
# Verifies provider callbacks. >= 16 characters (sandbox demo still uses it).
PAYMENT_CALLBACK_SECRET=REPLACE_WITH_AT_LEAST_16_CHARS

# Private S3-compatible bucket on the Neon branch (no public access).
S3_ENDPOINT=https://REPLACE_BRANCH.storage.REPLACE_REGION.neon.tech
S3_REGION=us-east-1
S3_BUCKET=healthwallet-demo-documents
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE

# --- Frontend (Vercel project settings, NOT a .env file) ---
# VITE_APP_ENV=demo      # shows the demo label and enables the demo entry
# VITE_API_BASE_URL=     # empty => same-origin requests through Edge Middleware
# NEON_FUNCTION_URL=https://<branch>-healthwallet.compute.<region>.aws.neon.tech
# ORIGIN_SECRET=<same value as the backend>
