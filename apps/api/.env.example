APP_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://healthwallet:healthwallet@127.0.0.1:5432/healthwallet_dev
CORS_ORIGIN=http://localhost:5173
AI_ADAPTER=sandbox
PAYMENT_ADAPTER=sandbox
MESSAGING_ADAPTER=sandbox
STORAGE_ADAPTER=local
STORAGE_LOCAL_ROOT=./storage
DEFAULT_CURRENCY=LRD
LOG_LEVEL=info

# Phone verification: sandbox (development only) or twilio.
PHONE_VERIFICATION_PROVIDER=sandbox
# Configure all three only when using the live Twilio verification delivery provider.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+...
# Required for authenticator enrollment: 32 random bytes encoded as 64 hex characters.
# Keep stable in your secret manager. Do not commit the real value.
# SECURITY_ENCRYPTION_KEY=...

# Durable private Neon/S3 storage (required for production documents).
# STORAGE_ADAPTER=s3
# S3_ENDPOINT=https://your-branch.storage.your-region.neon.tech
# S3_REGION=us-east-1
# S3_BUCKET=healthwallet-documents
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
