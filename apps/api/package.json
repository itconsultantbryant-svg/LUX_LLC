{
  "name": "@healthwallet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:up": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "IDENTITY_DATABASE_TESTS=1 vitest run src/modules/identity/postgres.integration.test.ts --testTimeout=30000 --hookTimeout=30000",
    "db:seed": "tsx src/db/seed.ts --synthetic && node scripts/seed-demo-portals.mjs",
    "seed:demo-portals": "node scripts/seed-demo-portals.mjs",
    "seed:admin": "node scripts/seed-dev-admin.mjs",
    "worker:reconcile": "tsx src/workers/reconcile.ts",
    "worker:retention": "tsx src/workers/retention.ts",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "audit:check": "node scripts/check-dependencies.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:ledger": "node scripts/run-ledger-tests.mjs",
    "test:validation": "node scripts/run-validation-tests.mjs",
    "test:assistance": "node scripts/run-assistance-tests.mjs",
    "test:partners": "node scripts/run-partners-tests.mjs",
    "test:security": "node scripts/run-security-tests.mjs",
    "test:funding": "node scripts/run-funding-tests.mjs",
    "test:operations": "node scripts/run-operations-tests.mjs",
    "test:providers": "node scripts/run-provider-tests.mjs",
    "test:evaluation": "node scripts/run-evaluation-tests.mjs",
    "test:journey": "node scripts/run-journey-tests.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fastify/cors": "^11.1.0",
    "@healthwallet/shared": "workspace:*",
    "@neon/functions": "^0.11.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
