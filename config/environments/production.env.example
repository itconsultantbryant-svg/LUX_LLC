APP_ENV=production
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/healthwallet
CORS_ORIGIN=https://REPLACE_WEB_ORIGIN
# Keep sandbox until Orange Money / AI / messaging credentials are confirmed.
AI_ADAPTER=sandbox
PAYMENT_ADAPTER=sandbox
MESSAGING_ADAPTER=live
STORAGE_ADAPTER=s3
STORAGE_LOCAL_ROOT=./storage
DEFAULT_CURRENCY=LRD
LOG_LEVEL=info
# Never commit real secrets. Inject via a secret manager.

# Phone verification: sandbox (development only) or twilio.
PHONE_VERIFICATION_PROVIDER=twilio
# Configure all three only when using the live Twilio verification delivery provider.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+...
# Required for authenticator enrollment: 32 random bytes encoded as 64 hex characters.
# Keep stable in your secret manager. Do not commit the real value.
# SECURITY_ENCRYPTION_KEY=...

# Private bucket on the production Neon branch (never reuse development credentials).
S3_ENDPOINT=https://REPLACE_PRODUCTION_BRANCH.storage.REPLACE_REGION.neon.tech
S3_REGION=us-east-1
S3_BUCKET=healthwallet-documents
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# ORIGIN_SECRET=...

# Required in production: verifies provider payment callbacks (>=16 chars).
# PAYMENT_CALLBACK_SECRET=...
# Signs short-lived, actor-bound document download links (>=16 chars).
# Falls back to SECURITY_ENCRYPTION_KEY when unset.
# DOWNLOAD_LINK_SECRET=...
# DOWNLOAD_LINK_TTL_SECONDS=120
# Global mutation rate limit (requests per window per client IP).
# RATE_LIMIT_MUTATIONS=600
# RATE_LIMIT_WINDOW_SECONDS=900
# Data-retention windows in days (financial/audit records are never purged).
# RETENTION_SESSION_DAYS=30
# RETENTION_OTP_DAYS=2
# RETENTION_IDENTITY_LIMIT_DAYS=30
# RETENTION_AI_ARTIFACT_DAYS=365
# RETENTION_DOCUMENT_DAYS=365
# RETENTION_AUDIT_DAYS=2555
# Enable the sandbox USSD menu (leave off unless requested).
# USSD_SANDBOX_ENABLED=false
