{
  "name": "lux-healthpay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @lux/web --filter @lux/api --filter @lux/worker dev",
    "build": "pnpm --filter @lux/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @lux/web typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "format": "prettier --write apps packages db tests docs *.json *.yml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@neon/functions": "^0.11.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "better-auth": "1.7.20",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
